# Copy to .env and adjust. All values are optional; defaults shown.
QUOTE_REFRESH_INTERVAL=10m
CLOSE_INGEST_AT=15:00
EVENING_INGEST_AT=20:00
# Minimum gap between requests to TWSE/TPEx web endpoints (too fast = IP ban)
WEB_REQUEST_INTERVAL=3s
# Optional, for filling data gaps via FinMind
FINMIND_TOKEN=
